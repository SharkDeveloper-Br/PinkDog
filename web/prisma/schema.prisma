// Schema adaptado para SQLite (dev local sem Docker)
// Para producao PostgreSQL: troque provider para "postgresql" e use Decimal @db.Decimal(10,2) + String[]

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTENTICACAO & USUARIOS
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // hash bcrypt
  name      String
  role      String   // ADMIN, VET, GROOMER, RECEPTION
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacoes
  staff          StaffMember?
  appointmentsAsVet    Appointment[] @relation("VetAppointments")
  appointmentsAsGroomer Appointment[] @relation("GroomerAppointments")
  medicalRecords MedicalRecord[]
}

// ==========================================
// 2. FUNCIONARIOS / STAFF
// ==========================================

model StaffMember {
  id            String   @id @default(uuid())
  userId        String?  @unique
  name          String
  sector        String   // SPA, VET, GERAL
  roleTitle     String   // Cargo especifico ex: "Groomer Senior"
  crmv          String?  // CRMV-SP xxx (somente veterinarios)
  status        String   @default("ACTIVE") // ACTIVE, OFF_DUTY, VACATION, INACTIVE

  // Permissoes operacionais
  permAdvanceStages Boolean @default(false)
  permEditRecords   Boolean @default(false)
  permFinancial     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacoes
  user           User?    @relation(fields: [userId], references: [id])
  inventoryMoves InventoryMovement[]
}

// ==========================================
// 3. CLIENTES (TUTORES)
// ==========================================

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  cpf       String?  @unique
  address   String?
  password  String?  // hash bcrypt — populado no cadastro online
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacoes
  pets    Pet[]
}

// ==========================================
// 4. PETS (PACIENTES)
// ==========================================

model Pet {
  id          String   @id @default(uuid())
  name        String
  species     String   // DOG, CAT, OTHER
  breed       String
  weight      Float?   // kg
  birthDate   DateTime?
  alert       String?  // Alerta medico/comportamental
  notes       String?  // Observacoes gerais
  preferredSector String? @default("SPA") // Ala de atendimento inicial
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacoes
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  medicalRecords MedicalRecord[]
}

// ==========================================
// 5. SERVICOS (CATALOGO)
// ==========================================

model Service {
  id          String   @id @default(uuid())
  name        String
  category    String   // BATH, GROOMING, VET_CONSULT, VACCINE, SURGERY, CHECKUP, OTHER
  description String?
  price       Float
  durationMin Int      // Duracao estimada em minutos
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacoes
  appointments Appointment[]
}

// ==========================================
// 6. AGENDAMENTOS
// ==========================================

model Appointment {
  id          String   @id @default(uuid())
  date        DateTime // Data do agendamento
  time        String   // Horario (HH:MM)

  status      String   @default("SCHEDULED")
  currentStep Int      @default(0)

  checklist   String?
  notes       String?
  tutorNotes  String?

  checkedInAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacoes
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id])

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])

  vetId     String?
  vet       User?    @relation("VetAppointments", fields: [vetId], references: [id])

  groomerId String?
  groomer   User?    @relation("GroomerAppointments", fields: [groomerId], references: [id])

  // Financeiro
  priceCharged Float?
  isPaid       Boolean  @default(false)
  paymentMethod String? // PIX, CREDIT_CARD, DEBIT_CARD, CASH
}

// ==========================================
// 7. PRONTUARIO CLINICO
// ==========================================

model MedicalRecord {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  title       String
  description String
  diagnosis   String?
  prescription String?
  attachments String

  createdAt   DateTime @default(now())

  // Relacoes
  petId   String
  pet     Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  vetId   String
  vet     User   @relation(fields: [vetId], references: [id])
}

// ==========================================
// 8. PRODUTOS & ESTOQUE
// ==========================================

model Product {
  id          String   @id @default(uuid())
  name        String
  category    String   // VACCINE, MEDICATION, SHAMPOO, FOOD, SUPPLY, OTHER
  sku         String   @unique
  description String?
  unit        String
  minStock    Int      @default(0)
  currentStock Int     @default(0)
  costPrice   Float?
  salePrice   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacoes
  movements InventoryMovement[]
}

model InventoryMovement {
  id          String   @id @default(uuid())
  type        String   // IN, OUT, ADJUST, RETURN
  quantity    Int
  reason      String
  createdAt   DateTime @default(now())

  // Relacoes
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id])
}

// ==========================================
// 9. NOTIFICACOES / LOG
// ==========================================

model NotificationLog {
  id        String   @id @default(uuid())
  channel   String   // WHATSAPP, SMS, EMAIL
  recipient String
  message   String
  sentAt    DateTime @default(now())
  status    String   // SENT, FAILED, PENDING
}
